PORT=3000
NODE_ENV=development

# 로컬 DB (db/create-user.sql 로 만든 DB·계정)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamers_db
DB_USER=gamers
DB_PASSWORD=
# 개발 환경(NODE_ENV=development)에서 서버가 뜰 때 db/seed.sql 테스트 데이터를 한 번 넣는다. 끄려면 false
DB_SEED=true

# JWT Access Token 서명 비밀키 (API 명세 1.2). 충분히 긴 임의 문자열을 넣는다
# 예: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Grandmaster·Challenger 순위를 다시 계산하는 주기(분). 기본 10. 등급 변화를 빨리 보려면 1
RANKING_INTERVAL_MINUTES=10

# 프록시 뒤에서 회원 IP를 X-Forwarded-For에서 읽을지 (Express trust proxy). 로컬은 비워 둔다
# 운영(Vercel rewrite → 호스팅 로드밸런서 → 서버)은 앞에 있는 프록시 수, 보통 2
TRUST_PROXY=

# 업로드 파일 저장 폴더(상대 경로면 backend/ 기준)와 파일 URL 앞부분. 생략하면 아래 기본값
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:3000/uploads

# 클라우드 DB TLS 접속. DB_SSL_CA 에 CA 인증서(PEM 내용, 줄바꿈은 \n)를 넣거나 DB_SSL=true 로 기본 인증서를 쓴다. 로컬은 비워 둔다
DB_SSL=
DB_SSL_CA=
# DB 연결 풀 크기. 기본 10. Vercel은 함수 인스턴스마다 풀을 만들므로 2~3 정도로 줄인다
DB_CONNECTION_LIMIT=

# Vercel 배포 전용. Blob 저장소를 연결하면 자동으로 들어가며, 있으면 업로드를 디스크 대신 Vercel Blob에 저장한다
BLOB_READ_WRITE_TOKEN=
# Vercel Cron이 정리 작업(/cron/daily)을 부를 때 확인하는 비밀값. 충분히 긴 임의 문자열
CRON_SECRET=
