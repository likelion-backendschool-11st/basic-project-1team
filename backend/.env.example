PORT=3000
NODE_ENV=development

# 로컬 DB (db/create-user.sql 로 만든 DB·계정)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamers_db
DB_USER=gamers
DB_PASSWORD=
# 개발 환경(NODE_ENV=development)에서 서버가 뜰 때 db/seed.sql 테스트 데이터를 한 번 넣는다. 끄려면 false
DB_SEED=true

# JWT Access Token 서명 비밀키 (API 명세 1.2). 충분히 긴 임의 문자열을 넣는다
# 예: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 업로드 파일 저장 폴더(상대 경로면 backend/ 기준)와 파일 URL 앞부분. 생략하면 아래 기본값
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:3000/uploads
